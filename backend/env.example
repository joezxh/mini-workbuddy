# ==================== 应用配置 ====================
# 应用名称
APP_NAME=风险管控系统
# 应用版本
APP_VERSION=1.0.0
# 运行环境: development, production, testing
ENVIRONMENT=development
# 调试模式
DEBUG=True
# API 前缀
API_PREFIX=/api/v1
# 允许的跨域源（多个用逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== 服务器配置 ====================
# 服务器主机
HOST=0.0.0.0
# 服务器端口
PORT=8000
# 工作进程数（生产环境建议设置为 CPU 核心数）
WORKERS=4

# ==================== 数据库配置 ====================
# PostgreSQL 数据库连接
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin123
DB_NAME=miniworkbuddy
# 数据库连接池配置
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
# 是否显示 SQL 语句（开发环境可设为 True）
DB_ECHO=False

# ==================== Redis 配置 ====================
# Redis 连接
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Redis 连接池配置
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
# 缓存过期时间（秒）
CACHE_EXPIRE_TIME=3600

# ==================== JWT 认证配置 ====================
# JWT 密钥（生产环境请使用强随机字符串）
JWT_SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
# JWT 算法
JWT_ALGORITHM=HS256
# Access Token 过期时间（分钟）
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh Token 过期时间（天）
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 密码加密配置 ====================
# 密码哈希算法
PASSWORD_HASH_ALGORITHM=bcrypt
# Bcrypt 轮次
PASSWORD_HASH_ROUNDS=12

# ==================== 数据加密配置 ====================
# 敏感数据加密密钥（AES-256，必须是 32 字节）
ENCRYPTION_KEY=your-32-byte-encryption-key-here-change-in-production!!
# 加密算法
ENCRYPTION_ALGORITHM=AES-256-CBC

# ==================== Dify 配置 ====================
# Dify API 基础 URL
DIFY_API_URL=http://localhost:5200/v1
# Dify API Key
DIFY_API_KEY=app-
# Dify 请求超时时间（秒）
DIFY_TIMEOUT=60
# blocking /workflows/run 等待完整响应（读）超时（秒），事件处理等长链路建议 600～900
DIFY_WORKFLOW_HTTP_TIMEOUT_SECONDS=600
# Dify 最大重试次数
DIFY_MAX_RETRIES=3

# ==================== Graphiti 配置 ====================
# 是否启用 Graphiti 图谱功能
GRAPHITI_ENABLED=False
# Graphiti API 基础 URL
GRAPHITI_API_BASE_URL=http://localhost:8001
# Graphiti API Key
GRAPHITI_API_KEY=your-graphiti-api-key-here
# Graphiti 超时时间（秒）
GRAPHITI_TIMEOUT=30
# 自动提取关系的最小置信度阈值
GRAPHITI_MIN_CONFIDENCE=0.7

# ==================== Neo4j 图谱 ====================
# 是否启用 Neo4j（未部署或调试时可设为 False）
NEO4J_ENABLED=False
# Bolt 地址（Neo4j 5.x）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me

# ==================== 网络搜索服务配置 ====================
# 博查 API 配置
BOCHA_ENABLED=True
BOCHA_API_BASE_URL=https://api.bocha.com
BOCHA_API_KEY=your-bocha-api-key-here
BOCHA_API_SECRET=your-bocha-api-secret-here
BOCHA_TIMEOUT=30
BOCHA_MAX_RESULTS=50
BOCHA_DAILY_QUOTA=1000

# 数眼智能 API 配置
SHUYAN_ENABLED=True
SHUYAN_API_BASE_URL=https://api.shuyanai.com/v1
SHUYAN_API_KEY=your-shuyan-api-key-here
SHUYAN_TIMEOUT=30
SHUYAN_MAX_RESULTS=50
SHUYAN_DAILY_QUOTA=500
SHUYAN_PRIORITY=1

# 安思派 (Anspire) API 配置
ANSPIRE_ENABLED=True
ANSPIRE_API_BASE_URL=https://api.anspire.com/v1
ANSPIRE_API_KEY=your-anspire-api-key-here
ANSPIRE_TIMEOUT=30
ANSPIRE_MAX_RESULTS=50
ANSPIRE_DAILY_QUOTA=500
ANSPIRE_PRIORITY=2

# Firecrawl 私有化部署配置（兜底方案）
FIRECRAWL_ENABLED=True
FIRECRAWL_API_BASE_URL=http://localhost:3002
FIRECRAWL_API_KEY=your-firecrawl-api-key-here
FIRECRAWL_TIMEOUT=60
FIRECRAWL_MAX_RESULTS=100
FIRECRAWL_DAILY_QUOTA=10000
FIRECRAWL_PRIORITY=99

# 搜索服务通用配置
SEARCH_AUTO_FALLBACK=True
SEARCH_RETRY_TIMES=3
SEARCH_CACHE_ENABLED=True
SEARCH_CACHE_TTL=3600

# ==================== 文件上传配置 ====================
# 上传文件存储路径
UPLOAD_DIR=./uploads
# 允许的文件类型（多个用逗号分隔）
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.txt
# 单个文件最大大小（MB）
MAX_FILE_SIZE_MB=10
# 总上传大小限制（MB）
MAX_TOTAL_UPLOAD_SIZE_MB=100

# ==================== 日志配置 ====================
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# 日志文件路径
LOG_FILE=./logs/app.log
# 日志文件最大大小（MB）
LOG_MAX_SIZE_MB=100
# 日志文件保留数量
LOG_BACKUP_COUNT=10
# 是否输出到控制台
LOG_TO_CONSOLE=True
# 日志格式
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ==================== 定时任务配置 ====================
# 是否启用定时任务
SCHEDULER_ENABLED=True
# 定时任务时区
SCHEDULER_TIMEZONE=Asia/Shanghai
# 日报生成时间（cron 表达式）
SCHEDULE_DAILY_REPORT=0 9 * * *
# 周报生成时间（每周一 9:00）
SCHEDULE_WEEKLY_REPORT=0 9 * * 1
# 月报生成时间（每月 1 号 9:00）
SCHEDULE_MONTHLY_REPORT=0 9 1 * *
# 风险评级更新时间（每天 2:00）
SCHEDULE_RISK_RATING=0 2 * * *
# 聚类分析时间（每天 3:00）
SCHEDULE_CLUSTERING=0 3 * * *

# ==================== 邮件配置 ====================
# SMTP 服务器
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP 用户名
SMTP_USER=your-email@example.com
# SMTP 密码
SMTP_PASSWORD=your-email-password
# 发件人邮箱
SMTP_FROM=noreply@example.com
# 发件人名称
SMTP_FROM_NAME=风险管控系统
# 是否使用 TLS
SMTP_TLS=True
# 是否使用 SSL
SMTP_SSL=False

# ==================== 监控配置 ====================
# 是否启用性能监控
MONITORING_ENABLED=True
# Prometheus 指标端口
METRICS_PORT=9090
# 健康检查端点
HEALTH_CHECK_PATH=/health
# 是否启用请求追踪
TRACING_ENABLED=False
# Jaeger Agent 地址
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# ==================== 安全配置 ====================
# 是否启用 HTTPS
HTTPS_ENABLED=False
# SSL 证书路径
SSL_CERT_PATH=./certs/cert.pem
# SSL 密钥路径
SSL_KEY_PATH=./certs/key.pem
# 是否启用 CSRF 保护
CSRF_ENABLED=True
# 是否启用 XSS 保护
XSS_PROTECTION=True
# 是否启用内容安全策略
CSP_ENABLED=True
# API 请求频率限制（每分钟）
RATE_LIMIT_PER_MINUTE=100
# 登录失败最大次数
MAX_LOGIN_ATTEMPTS=5
# 登录锁定时间（分钟）
LOGIN_LOCKOUT_MINUTES=15

# ==================== 备份配置 ====================
# 是否启用自动备份
BACKUP_ENABLED=True
# 备份存储路径
BACKUP_DIR=./backups
# 备份保留天数
BACKUP_RETENTION_DAYS=30
# 数据库备份时间（每天 1:00）
BACKUP_SCHEDULE=0 1 * * *

# ==================== 第三方服务配置 ====================
# 是否启用第三方数据同步
THIRD_PARTY_SYNC_ENABLED=True
# 同步间隔（分钟）
SYNC_INTERVAL_MINUTES=30
# 同步超时时间（秒）
SYNC_TIMEOUT=300

# ==================== 开发配置 ====================
# 是否启用热重载
HOT_RELOAD=True
# 是否启用 API 文档
ENABLE_DOCS=True
# API 文档路径
DOCS_URL=/docs
# ReDoc 文档路径
REDOC_URL=/redoc
# 是否启用测试模式
TEST_MODE=False
# 测试数据库名称
TEST_DB_NAME=miniworkbuddy_test

# ==================== OpenTelemetry 配置 ====================
OTEL_ENABLED=true
OTEL_SERVICE_NAME=miniworkbuddy-agent
OTEL_EXPORTER=console  # console | jaeger | otlp

