# 生产环境配置

# 后端 API 地址（生产环境，使用相对路径，由 Nginx 反向代理）
VITE_API_BASE_URL=http://192.168.31.47

# 应用标题
VITE_APP_TITLE=风险管控系统

# 是否启用 Mock 数据
VITE_USE_MOCK=false

# 日志级别：debug/info/warn/error
VITE_LOG_LEVEL=error

# 是否启用调试工具
VITE_ENABLE_DEVTOOLS=false

# 是否显示性能监控
VITE_ENABLE_PERF=true

# SSE 连接超时时间（秒）
VITE_SSE_TIMEOUT=60

# 请求超时时间（毫秒）
VITE_REQUEST_TIMEOUT=60000
