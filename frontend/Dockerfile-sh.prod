# 生产环境 Dockerfile - 支持本地预构建
# 使用本地构建: docker build --target local -f Dockerfile.prod .
# 使用远程构建（默认）: docker build -f Dockerfile.prod .

# 本地构建阶段 - 使用本地 dist 目录，直接生成可运行的 Nginx 镜像
FROM registry.cn-hangzhou.aliyuncs.com/tianque-cloud/nginx:latest AS local

RUN mkdir -p /app
WORKDIR /app

COPY dist /app

RUN rm -rf /usr/share/nginx/html/* && cp -r /app/* /usr/share/nginx/html/

COPY nginx.conf /etc/nginx/nginx.conf
COPY nginx.default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

# 远程构建阶段 - 使用 npm/node 构建
FROM registry.cn-hangzhou.aliyuncs.com/tianque-cloud/node:20-alpine AS builder

# 设置工作目录
WORKDIR /app

# 安装 pnpm
RUN npm install -g pnpm

# 复制依赖文件
COPY package.json pnpm-lock.yaml ./

RUN pnpm config set registry https://registry.npmmirror.com


# 安装依赖（仅生产依赖）
RUN pnpm install --frozen-lockfile

# 复制应用代码
COPY . .

# 构建生产版本
RUN pnpm run build

# 生产阶段 - 使用 Nginx
FROM registry.cn-hangzhou.aliyuncs.com/tianque-cloud/nginx:latest

RUN mkdir -p /app

# 将工作目录设置为 /app
WORKDIR /app

# 将宿主机 front目录下的文件复制到容器的 /app 目录
# 注意这里不要写绝对路径
COPY --from=builder /app/dist   /app

# 删除 nginx 容器中代码目录中自带的文件
RUN rm /usr/share/nginx/html/*

# 将/app 中所有文件复制到 /usr/share/nginx/html/
RUN cp -r /app/*  /usr/share/nginx/html/

# 复制 nginx 全局配置
COPY nginx.conf /etc/nginx/nginx.conf

# 复制 nginx 虚拟主机配置（SPA 路由 + API 代理）
COPY nginx.default.conf /etc/nginx/conf.d/default.conf

# 暴露 80 端口供外部访问
EXPOSE 80

# 容器启动时运行 Nginx
CMD ["nginx", "-g", "daemon off;"]
