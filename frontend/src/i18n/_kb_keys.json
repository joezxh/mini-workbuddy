  "kmsWiki.rollbackDescription": {
   "ctx": ":description=\"t('kmsWiki.rollbackDescription', { from: versionNumber, to: (currentVersion || 0) + 1 })\"",
   "ph": []
  },
  "kmsWiki.rollbackToVersion": {
   "ctx": "{{ t('kmsWiki.rollbackToVersion') }}",
   "ph": []
  },
  "kmsWiki.rolledBack": {
   "ctx": "message.success(t('kmsWiki.rolledBack'))",
   "ph": []
  },
  "kmsWiki.rollbackFailed": {
   "ctx": "message.error(e?.response?.data?.detail || t('kmsWiki.rollbackFailed'))",
   "ph": []
  },
  "kmsWiki.operation": {
   "ctx": ":description=\"`${item.change_note || t('kmsWiki.noNote')} · ${t('kmsWiki.operation')}:${item.operation_type} · ${formatDate(item.created_at)}`\"",
   "ph": []
  },
  "kmsWiki.compare": {
   "ctx": "<a @click=\"showDiff(item)\">{{ t('kmsWiki.compare') }}</a>",
   "ph": []
  }
 }
}