# 日常测试环境配置

# 后端 API 地址（日常测试环境）
VITE_API_BASE_URL=http://api.rc.hztianque.com

# 应用标题
VITE_APP_TITLE=风险管控系统 - 日常测试

# 是否启用 Mock 数据
VITE_USE_MOCK=false

# 日志级别：debug/info/warn/error
VITE_LOG_LEVEL=info

# 是否启用调试工具
VITE_ENABLE_DEVTOOLS=true

# 是否显示性能监控
VITE_ENABLE_PERF=false

# SSE 连接超时时间（秒）
VITE_SSE_TIMEOUT=30

# 请求超时时间（毫秒）
VITE_REQUEST_TIMEOUT=30000
