# 桌面端（Electron）构建配置，仅由 scripts/electron.cjs 使用（--mode electron）
#
# 关键点：不烘焙后端地址。
# 桌面端运行时从主进程 userData/app-config.json 读取后端地址，客户端里可随时修改，
# 改完无需重新打包。
# Vite 中 .env.<mode> 的优先级高于 .env.local，因此这里必须显式置空，
# 否则开发机的 .env.local 地址会被烘焙进安装包。

# 后端 API 地址（留空：由桌面端运行时配置决定）
VITE_API_BASE_URL=

# 应用标题
VITE_APP_TITLE=MiniWorkBuddy

# 是否启用 Mock 数据
VITE_USE_MOCK=false

# 日志级别：debug/info/warn/error
VITE_LOG_LEVEL=error

# 是否启用调试工具
VITE_ENABLE_DEVTOOLS=false

# 是否显示性能监控
VITE_ENABLE_PERF=false

# SSE 连接超时时间（秒）
VITE_SSE_TIMEOUT=60

# 请求超时时间（毫秒）
VITE_REQUEST_TIMEOUT=60000
