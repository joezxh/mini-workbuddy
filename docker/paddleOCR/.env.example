# =============================================================
# PaddleOCR 环境变量模板
# =============================================================

# ---------- 镜像 ----------
OCRV6_IMAGE=pp-ocrv6:local
STRUCTUREV3_IMAGE=pp-structurev3:local
NGINX_IMAGE=crpi-c762f77rjuytqer9.cn-hangzhou.personal.cr.aliyuncs.com/llm-basic/base/nginx:alpine

# ---------- 鉴权 ----------
# 调用方需在请求头携带 X-API-Key
PADDLE_API_KEY=CHANGE_ME

# ---------- 端口 ----------
OCR_GATEWAY_PORT=8080
OCR_DIRECT_PORT=8011
STRUCTURE_DIRECT_PORT=8012
OCR_LISTEN_PORT=80

# ---------- 上游服务地址（容器内）----------
OCR_UPSTREAM=pp-ocrv6:8000
