# =============================================================
# Mem0 环境变量模板
#
# 使用：cp .env.example .env 后填入真实值
# .env 已被 docker/.gitignore 忽略，不要提交真实口令
# =============================================================

# ---------- 源码路径（构建用，非容器内变量）----------
# mem0 官方仓库 checkout 根目录，需包含 server/ 与 server/dashboard/
SRC_MEM0=D:/projects/github/mem0

# ---------- PostgreSQL（向量库，含 pgvector 扩展）----------
POSTGRES_HOST=mwb-postgres-pgvector
POSTGRES_PORT=5432
POSTGRES_DB=mem0
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ---------- Neo4j（图记忆，可选）----------
NEO4J_URI=bolt://mwb-neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME

# ---------- 认证 ----------
# 本地开发可关闭认证；生产务必置为 false 并设置强随机 JWT_SECRET
AUTH_DISABLED=true
JWT_SECRET=CHANGE_ME_RANDOM_32BYTES

# ---------- LLM / Embedding ----------
# 注意：嵌入模型输出维度必须与 pgvector 列维度一致。
# 百炼 text-embedding-v4 输出 1024 维 → memories.vector 必须是 vector(1024)，
# 早期 OpenAI embedder 时代建的是 vector(1536)，CREATE TABLE IF NOT EXISTS 不会改列，
# 需要手动 ALTER TABLE memories ALTER COLUMN vector TYPE vector(1024)。
OPENAI_API_KEY=CHANGE_ME

# ---------- 端口映射 ----------
MEM0_API_PORT=8888
MEM0_DASHBOARD_PORT=3001
