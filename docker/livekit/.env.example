# =============================================================
# LiveKit compose 变量（被 docker-compose.yml 读取）
#   cp .env.example .env
#
# 注意：真正的 server 鉴权密钥写在 livekit.yaml（keys / turn 段），
#       不在本文件。本文件里的 KEY/SECRET 仅作为「后端需与之一致」的
#       参考备忘，改 livekit.yaml 时请同步更新这里并回填 backend/.env。
# =============================================================

# 镜像中转仓库前缀（默认与 docker/registry.env 的 BASE_REGISTRY 一致，可覆盖）
BASE_REGISTRY=crpi-c762f77rjuytqer9.cn-hangzhou.personal.cr.aliyuncs.com/llm-basic/base

# LiveKit server 版本 —— 2026-11 核实：GitHub Releases 最新稳定版即 v1.13.11，禁止 latest
LIVEKIT_VERSION=v1.13.11

# Egress 录制版本 —— 2026-11 核实：v1.15.0（2026-10-06）
LIVEKIT_EGRESS_VERSION=v1.15.0

# ---- 与 livekit.yaml 保持一致的密钥（默认即 dev 占位值 devkey/secret）----
# 生产：先 `docker run --rm livekit/livekit-server:<ver> generate-keys`，
#      改 livekit.yaml 的 keys，再把下面两行同步为真实值并写入 backend/.env
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---- 后端 backend/.env 需要的连接地址（此处仅为对照，实际写进 backend/.env）----
# LIVEKIT_HTTP_URL=http://localhost:7880
# LIVEKIT_WS_URL=ws://localhost:7880
