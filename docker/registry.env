# =============================================================
# 镜像仓库统一配置 —— 唯一配置源
#
# 本文件被 docker 目录下所有 .ps1 / .sh 脚本共同读取。
# 修改这里即可切换到其它仓库或命名空间，无需改动任何脚本。
#
# 镜像最终命名规则：
#   ${REGISTRY}/${COMPONENT}:${IMAGE_TAG}
#   例：crpi-c762f77rjuytqer9.cn-hangzhou.personal.cr.aliyuncs.com/llm-basic/mem0-api:1.0.0
# =============================================================

# 阿里云容器镜像服务 —— 个人版实例公网地址
REGISTRY_HOST=crpi-c762f77rjuytqer9.cn-hangzhou.personal.cr.aliyuncs.com

# 命名空间（在 ACR 控制台创建）
ACR_NAMESPACE=llm-basic

# 统一版本标签
IMAGE_TAG=1.0.0

# ---- 以下为派生值（由脚本直接读取，改上面两项时同步更新这里）----
# 业务镜像仓库前缀
REGISTRY=crpi-c762f77rjuytqer9.cn-hangzhou.personal.cr.aliyuncs.com/llm-basic
# 第三方基础镜像中转仓库前缀
BASE_REGISTRY=crpi-c762f77rjuytqer9.cn-hangzhou.personal.cr.aliyuncs.com/llm-basic/base
