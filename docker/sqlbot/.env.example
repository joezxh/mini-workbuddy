# =============================================================
# SQLBot 环境变量模板
#
# 使用：cp .env.example .env 后填入真实值
# =============================================================

# ---------- 镜像 ----------
SQLBOT_IMAGE=sqlbot:local
SQLBOT_PORT=8000
SQLBOT_MCP_PORT=8001

# ---------- 外部 PostgreSQL ----------
POSTGRES_SERVER=mwb-postgres-pgvector
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sqlbot

# ---------- 安全密钥 ----------
# 必须与 build.ps1 -SecretKey / build.sh --secret-key 传入的值一致！
# 前端用它（取前 32 字节）做 AES-CBC 加密账号口令，后端用它解密。
# 不一致的表现：页面能打开，但登录报账号密码错误。
SECRET_KEY=CHANGE_ME_RANDOM_STRING

# ---------- 缓存 ----------
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://redis:6379/1

# ---------- 其它 ----------
PROJECT_NAME=SQLBot
DEFAULT_PWD=SQLBot@123456
LOG_LEVEL=INFO
SQL_DEBUG=false
EMBEDDING_ENABLED=false
TABLE_EMBEDDING_ENABLED=false
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:8000
SERVER_IMAGE_HOST=http://localhost:8001/images/
