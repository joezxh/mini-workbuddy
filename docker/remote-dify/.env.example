# =============================================================
# Dify 远程部署环境变量模板
#
# 使用：cp .env.example .env 后填入真实值
# .env 已被 docker/.gitignore 忽略
# =============================================================

# ---------- 镜像仓库 ----------
# 业务镜像命名空间（已由 _common/prepull.* 完成中转）
REGISTRY=crpi-c762f77rjuytqer9.cn-hangzhou.personal.cr.aliyuncs.com/llm-basic
GATEWAY_IMAGE=crpi-c762f77rjuytqer9.cn-hangzhou.personal.cr.aliyuncs.com/llm-basic/mwb-nginx-gateway:1.0.0

# ---------- 集中式 PostgreSQL ----------
DB_HOST=CHANGE_ME
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_DATABASE=dify
PLUGIN_DB_DATABASE=dify_plugin

# ---------- 向量库 pgvector（通常与业务库同实例）----------
PGVECTOR_HOST=CHANGE_ME
PGVECTOR_PORT=5432
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=CHANGE_ME
PGVECTOR_DATABASE=dify

# ---------- 集中式 Redis ----------
REDIS_HOST=CHANGE_ME
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
CELERY_BROKER_DB=1

# ---------- 密钥 ----------
# 同一份密钥会被 SECRET_KEY / PLUGIN_DAEMON_KEY / INNER_API_KEY_FOR_PLUGIN /
# SERVER_KEY 复用，部署时请替换为强随机值
DIFY_SECRET_KEY=CHANGE_ME_RANDOM_STRING
SANDBOX_API_KEY=CHANGE_ME

# ---------- 对外地址 ----------
# 浏览器侧访问地址，需与实际入口保持一致（含端口）
DIFY_BASE_URL=http://192.168.110.60:8080
DIFY_MARKETPLACE_URL=http://192.168.110.60:8888

# ---------- 端口映射 ----------
GATEWAY_PORT=8080
MARKETPLACE_PORT=8888

# ---------- 其它 ----------
LOG_LEVEL=INFO
