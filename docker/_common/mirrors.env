# =============================================================
# 国内镜像源统一清单
#
# 所有 Dockerfile / 构建脚本从这里取源地址，避免各处硬编码。
# 备注中的实测吞吐来自 PaddleOCR 构建时的记录，用于解释取舍。
# =============================================================

# ---------- Debian / Ubuntu apt ----------
# Debian bookworm 起源文件改为 /etc/apt/sources.list.d/debian.sources，
# 换源需同时处理 URIs 行；Ubuntu 则是 /etc/apt/sources.list。
APT_MIRROR_ALIYUN=mirrors.aliyun.com
APT_MIRROR_TUNA=mirrors.tuna.tsinghua.edu.cn

# ---------- PyPI ----------
# 主源：阿里云（稳定）；备源：华为云（大 wheel 实测最快 ~6.1MB/s）
# 实测参考：aliyun 84KB/s、清华回源 1.6MB/s、华为云 6.1MB/s、pypi.org 7.2MB/s
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
PIP_EXTRA_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple
PIP_TRUSTED_HOST=mirrors.aliyun.com repo.huaweicloud.com pypi.tuna.tsinghua.edu.cn

# ---------- npm ----------
NPM_REGISTRY=https://registry.npmmirror.com

# ---------- Alpine apk ----------
APK_MIRROR=https://mirrors.aliyun.com/alpine

# ---------- uv ----------
UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple
UV_HTTP_TIMEOUT=180

# ---------- PyTorch wheel（国内可用索引）----------
# cpu 版走官方 cpu 索引；cu128 版优先用阿里云 FILES 镜像，回退官方
TORCH_INDEX_CPU=https://download.pytorch.org/whl/cpu
TORCH_INDEX_CU128=https://mirrors.aliyun.com/pytorch-wheels/cu128

# ---------- HuggingFace ----------
# 容器内直连 huggingface.co 不稳定，统一走 hf-mirror
HF_ENDPOINT=https://hf-mirror.com

# ---------- Paddle 模型源 ----------
PADDLE_PDX_MODEL_SOURCE=modelscope
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
