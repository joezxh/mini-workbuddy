# =============================================================
# speech-to-speech 环境变量模板
# =============================================================

# ---------- 镜像 ----------
S2S_IMAGE=s2s-pipeline:local
LLAMA_IMAGE=crpi-c762f77rjuytqer9.cn-hangzhou.personal.cr.aliyuncs.com/llm-basic/base/llama-cpp:server-cuda

# ---------- GPU ----------
GPU_ID=0
PIPELINE_GPU_ID=0

# ---------- 端口 ----------
PIPELINE_PORT=8765
LLM_PORT=8080

# ---------- LLM（GPUStack 模式）----------
# 末尾不要带 /v1：GPUStack 的 OpenAI 兼容基址是 /v1-openai
GPUSTACK_BASE_URL=http://host.docker.internal/v1-openai
GPUSTACK_MODEL=Qwen3-8B
GPUSTACK_API_KEY=CHANGE_ME

# ---------- LLM（内置 llama.cpp 模式）----------
LLM_MODEL=ggml-org/gemma-4-E4B-it-GGUF

# ---------- STT / TTS ----------
STT_BACKEND=parakeet-tdt
TTS_BACKEND=qwen3
# torch 后端必须显式指定，默认的 ggml 会跑 CPU（RTF 3.7 → torch cuda 下 0.69）
QWEN3_TTS_BACKEND=torch
QWEN3_TTS_DEVICE=cuda
TTS_SPEAKER=Aiden
TTS_LANGUAGE=auto

# ---------- 其它 ----------
INIT_CHAT_PROMPT=You are a helpful voice assistant. Reply concisely and in the user's language.
HF_ENDPOINT=https://hf-mirror.com
