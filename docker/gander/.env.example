# =============================================================
# Gander 环境变量模板
# =============================================================

# ---------- 镜像 ----------
GANDER_LOCAL_IMAGE=gander-asr:local
GANDER_REMOTE_IMAGE=gander-thinker:local

# ---------- 远端 Thinker ----------
REMOTE_THINKER_HOST=CHANGE_ME
REMOTE_THINKER_PORT=8000

# ---------- 端口映射 ----------
WEB_PORT=8080
ASR_PORT=8995

# ---------- ASR ----------
# faster-whisper 本地模型目录（宿主机路径）→ 挂载到容器 /models/...
ASR_MODEL_DIR=/data/models/faster-whisper-large-v3
ASR_MODEL_PATH=/models/faster-whisper-large-v3
ASR_DEVICE=cuda
ASR_DEVICE_INDEX=0
ASR_COMPUTE_TYPE=float16
ASR_BEAM_SIZE=3
ASR_GPU_ID=0

# ---------- 远端模型（Dockerfile.remote 用，由 compose volume 提供）----------
REMOTE_MODEL_DIR=/data/models/MiniCPM-o-4_5
