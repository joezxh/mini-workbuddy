# MinWorkBuddy Environment Variables
# This file contains example configuration for all services.
# Copy this to .env and update values as needed.
# WARNING: Never commit .env files with real credentials to version control!

#############################################
# Core Application Settings
#############################################

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=minworkbuddy

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Secret Key (change in production!)
SECRET_KEY=your-super-secret-key-change-this-in-production

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

#############################################
# Embedding Service Configuration
#############################################

# GPUStack Embedding (default provider)
GPUSTACK_API_URL=http://192.168.40.30/v1
GPUSTACK_API_KEY=gpustack_api_key_here
GPUSTACK_EMBEDDING_MODEL=Qwen3-Embedding-4B
GPUSTACK_EMBEDDING_DIMENSION=768
GPUSTACK_CHAT_MODEL=qwen3-32b

# Alternative: NVIDIA NIM
NVIDIA_API_URL=http://localhost:8080/v1
NVIDIA_API_KEY=
NVIDIA_EMBEDDING_MODEL=Qwen3-Embedding-4B
NVIDIA_EMBEDDING_DIMENSION=768
NVIDIA_CHAT_MODEL=qwen3-32b

# Alternative: Alibaba DashScope
ALIBABA_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_EMBEDDING_DIMENSION=1024
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/api/v1

# Provider selection: gpustack | dashscope | nvidia
EMBEDDING_PROVIDER=gpustack

#############################################
# Mem0 Long-term Memory Service (Local Private Deployment)
#############################################

# === Mem0 Connection Configuration ===
# Mem0 RAG API address (for local private deployment)
MEM0_RAG_URL=http://192.168.110.169:8002

# Mem0 API Key (authentication)
MEM0_API_KEY=m0sk_ta2xhQeKvdmorEFuBsMdyKKW_YG2XeJqd2SGHFPJ2dw

# MCP Service Host (default: localhost)
MEM0_MCP_HOST=192.168.110.169

# MCP Service Port (default: 8080)
MEM0_MCP_PORT=8080

# === Mem0 Feature Switches ===
# Enable or disable Mem0 long-term memory service
MEM0_ENABLED=true

# Use Mem0 Cloud API vs Local Deployment
# Set to false for local private deployment
MEM0_USE_CLOUD_API=false

# === Mem0 Storage & Retrieval ===
# Maximum number of memory entries per user
MEM0_MAX_ENTRIES=10000

# Memory retention period (days) - auto-cleanup expired memories
MEM0_RETENTION_DAYS=90

# Embedding model name for vectorization
MEM0_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector dimension (matching embedding model)
MEM0_VECTOR_DIMENSION=384

# === Mem0 Performance & Caching ===
# Memory cache TTL (seconds)
MEM0_CACHE_TTL=3600

# Default maximum results for search queries
MEM0_SEARCH_LIMIT=10

# Top-K parameter for semantic search
MEM0_RETRIEVE_TOP_K=5

# === Mem0 Compression & Optimization ===
# Enable memory compression to reduce token usage
MEM0_ENABLE_COMPRESSION=false

# Token limit after memory compression
MEM0_COMPLETION_TOKEN_LIMIT=10000

# === User Identification ===
# Field name for user ID in memory records
MEM0_USER_ID_FIELD=user_id

#############################################
# Search Service Configuration
#############################################

# Search providers: baidu, exa, anspire, firecrawl
SEARCH_PROVIDER=baidu
BAIDI_API_KEY=your_baidu_api_key
EXA_API_KEY=your_exa_api_key
ANSPIRE_API_KEY=your_anspire_api_key
FIRECRAWL_API_KEY=your_firecrawl_api_key

#############################################
# Voice Configuration (RTC)
#############################################

VOUCH_CONFIG_PATH=/path/to/voice_config.json

#############################################
# OpenTelemetry Observability
#############################################

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=minworkbuddy

#############################################
# Audit Log Configuration
#############################################

AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=data/audit.log

#############################################
# Async Task Configuration
#############################################

ASYNC_TASK_QUEUE=default
ASYNC_TASK_WORKERS=4
